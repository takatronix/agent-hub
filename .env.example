# ---- hub ----
HUB_HOST=0.0.0.0          # Tailscale 内に公開するなら 0.0.0.0（Tailscale IP に bind してもよい）
HUB_PORT=8765
HUB_TOKEN=change-me-write-token
HUB_READ_TOKEN=change-me-read-token   # ブラウザ閲覧用。?token=... で開く
HUB_DATA_DIR=~/.agent-hub
# HUB_LOG=1                # アクセスログを出す

# ---- runner / hubctl / MCP (client side) ----
HUB_URL=http://100.67.35.127:8765
# HUB_TOKEN=change-me-write-token
# HUB_PUBLIC_URL=http://macstudio:8765   # MCP が返す run URL に使う
